# ---------------------------------------------------------------------------
# musicrec environment configuration
#
# Copy to `.env` and adjust:  cp .env.example .env
#
# Every variable below maps to a field in src/musicrec/core/config.py
# (pydantic-settings, case-insensitive). Unknown variables are ignored
# (extra="ignore"), so it is safe to keep extras in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
# Plain-text log format, used only when LOG_JSON=false.
#LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Optional log file; leave unset to log to stdout only (recommended in
# containers). (Legacy alias LOG_FILE is also honored.)
#LOG_FILE_PATH=logs/app.log

# --- CORS (list values are JSON arrays) --------------------------------------
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=["*"]
CORS_ALLOWED_METHODS=["*"]
CORS_ALLOWED_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=false

# --- Web (legacy Flask app in legacy/) ---------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# --- Security ----------------------------------------------------------------
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The insecure default in config.py is scheduled to become required.
SECRET_KEY=change-me-generate-a-real-secret

# --- Model --------------------------------------------------------------------
MODEL_N_ESTIMATORS=200
MODEL_RANDOM_STATE=42
# Legacy alias TEST_SPLIT is also honored.
MODEL_TEST_SPLIT=0.2
MODEL_CV_FOLDS=5
# JSON array; parsed as a tuple.
FEATURE_WEIGHTS=[0.6, 0.7]

# --- Data limits (upload validation) -------------------------------------------
MAX_MEMORY_USAGE_MB=1000

# --- Predictions ----------------------------------------------------------------
PREDICT_MAX_BATCH_SIZE=100

# --- Model cache (in-memory LRU, per process) -------------------------------------
MODEL_CACHE_MAX_SIZE=10

# --- Rate limiting (per API key, sliding window, per process) ----------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Docker Compose: PostgreSQL -----------------------------------------------------
POSTGRES_USER=musicrec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musicrec
# Host port mapping (unset to use the defaults):
#POSTGRES_PORT=5432

# --- Docker Compose: Redis ----------------------------------------------------------
#REDIS_PORT=6379

# --- Docker Compose: API host port mapping --------------------------------------------
#API_PORT=8000

# --- Reserved for the SaaS roadmap -----------------------------------------------------
# Not yet read by the application (no matching Settings fields). Compose passes
# these to the api/worker containers; pydantic-settings ignores them for now.
#DATABASE_URL=postgresql://musicrec:change-me@postgres:5432/musicrec
#REDIS_URL=redis://redis:6379/0
